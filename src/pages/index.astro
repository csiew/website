---
import AboutContent from "../components/AboutContent.astro";
import Outline from "../components/Outline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, absoluteUrl } from "../lib/site";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.name,
    url: absoluteUrl("/"),
    image: absoluteUrl("/profile.jpg"),
    jobTitle: "Software Engineer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Melbourne",
      addressCountry: "AU"
    },
    sameAs: [
      "https://linkedin.com/in/clarencesiew",
      "https://github.com/csiew",
      "https://mastodon.online/@csiew",
      "https://bsky.app/profile/csiew.bsky.social",
      "https://threads.net/@clarence_siew",
      "https://instagram.com/clarence_siew"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: absoluteUrl("/")
  }
];
---

<BaseLayout
  title={SITE.name}
  description={SITE.description}
  pathname="/"
  image="/profile.jpg"
  imageAlt={SITE.name}
  structuredData={structuredData}
>
  <AboutContent />
  <Outline />
</BaseLayout>
