---
import {
  Monitor,
  Moon,
  Sun
} from "@lucide/astro";
import { SITE } from "../lib/site";

const themeOptions = [
  { value: "auto", label: "Auto", icon: Monitor },
  { value: "light", label: "Light", icon: Sun },
  { value: "dark", label: "Dark", icon: Moon }
];
---

<header>
  <div class="header-content">
    <div class="site-title">
      <a href="/" aria-label="Clarence Siew homepage">
        <img src="/profile.jpg" alt="Clarence Siew" />
        <span>
          <strong>{SITE.name}</strong>
          <small>Software engineer</small>
        </span>
      </a>
    </div>
    <button type="button" class="theme-cycle" data-theme-cycle aria-label="Theme: Auto. Activate to switch to Light.">
      {themeOptions.map((option) => {
        const Icon = option.icon;

        return (
          <span class="theme-cycle-icon" data-theme-icon={option.value} hidden={option.value !== "auto"}>
            <Icon aria-hidden="true" size={16} stroke-width={2} />
          </span>
        );
      })}
      <span data-theme-label>Auto</span>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-cycle]");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    const icons = Array.from(button.querySelectorAll("[data-theme-icon]"));
    const label = button.querySelector("[data-theme-label]");
    const order = ["auto", "light", "dark"];
    const labels = { auto: "Auto", light: "Light", dark: "Dark" };

    function nextPreference(preference) {
      return order[(order.indexOf(preference) + 1) % order.length] ?? "light";
    }

    function syncButton() {
      const preference = document.documentElement.dataset.themePreference ?? "auto";
      const next = nextPreference(preference);

      icons.forEach((icon) => {
        icon.hidden = icon.dataset.themeIcon !== preference;
      });

      if (label) {
        label.textContent = labels[preference] ?? "Auto";
      }

      button.setAttribute("aria-label", `Theme: ${labels[preference] ?? preference}. Activate to switch to ${labels[next] ?? next}.`);
    }

    syncButton();

    button.addEventListener("click", () => {
      const preference = document.documentElement.dataset.themePreference ?? "auto";

      if (typeof window.setThemePreference === "function") {
        window.setThemePreference(nextPreference(preference));
      }
    });

    window.addEventListener("themechange", syncButton);
  })();
</script>
